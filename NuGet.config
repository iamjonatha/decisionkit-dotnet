<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources are cleared so that a contributor's machine-wide or organization feeds never
    influence a build of this repository. Restores must be reproducible from nuget.org alone.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
