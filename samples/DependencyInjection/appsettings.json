{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jev": {
    // The API key is deliberately absent. Supply it out of band, for example with
    // dotnet user-secrets set Jev:ApiKey <your-api-key>, or the Jev__ApiKey variable.
    "Endpoint": "https://api.typesafe.ai",
    "Model": "jev-latest",
    "AttemptTimeout": "00:00:10",
    "OperationTimeout": "00:00:30",

    "Retry": {
      "MaxAttempts": 3,
      "InitialDelay": "00:00:00.500",
      "BackoffFactor": 2,
      "MaxDelay": "00:00:05",
      "Jitter": 0.2,
      "RespectRetryAfter": true
    }
  }
}
